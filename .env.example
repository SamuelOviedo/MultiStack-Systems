# ── Supabase (obligatorio) ───────────────────────────────────────────────────
# Supabase → Project Settings → API: Project URL + publishable (anon) key.
# Reemplaza AMBOS valores: con los placeholders la app se niega a arrancar
# ("Missing or invalid Supabase environment variables") y el build de Vercel falla.
# VITE_SUPABASE_ANON_KEY se acepta como alias de VITE_SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_KEY"

# Origen público del sitio (sin barra final). Obligatorio en builds de producción
# para que los enlaces de confirmación de email no apunten a localhost.
# Producción: https://multistacksystems.com
# En localhost las redirecciones de auth usan siempre el origen local (la sesión
# se guarda en el localStorage de ese origen), así que no afecta al login en desarrollo.
VITE_SITE_URL=https://multistacksystems.com

# ── Ecosystem product URLs (optional) ────────────────────────────────────────
# Dejar vacío = el producto muestra estado sin enlace externo.
# TechOn con URL vacía redirige a /login (soporte interno actual).
# VITE_TECHON_URL=
# VITE_LICENSING_URL=
# VITE_WHATSAPP_PLATFORM_URL=

# ── Resend (transactional email) ─────────────────────────────────────────────
# Set via Supabase dashboard → Project Settings → Edge Functions → Secrets
# Do NOT commit the actual key. Generate at resend.com/api-keys
# RESEND_API_KEY=re_...

# ── Edge Function secrets (Supabase → Edge Functions → Secrets, NOT Vercel) ──
# SEND_EMAIL_HOOK_SECRET: secreto del Send Email Hook (Authentication → Hooks),
#   formato "v1,whsec_…". OBLIGATORIO para send-auth-email: sin él la función
#   rechaza todo y fallan el registro y la recuperación de contraseña.
# SEND_EMAIL_HOOK_SECRET=v1,whsec_...
# SITE_URL: origen usado en los enlaces de send-notification
#   (por defecto https://www.multistacksystems.com).
# SITE_URL=https://www.multistacksystems.com
VITE_GADS_ID=
VITE_GADS_CONTACT_LABEL=
