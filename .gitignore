# Claude Code — local settings may contain tokens/credentials
.claude/settings.local.json

# Environment files — never commit secrets
.env
.env.local
.env.production
.env.*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules/
dist/
dist-ssr/
.vercel/
*.local

# Supabase CLI temp files
supabase/.temp/
supabase/.branches/

# Deno lockfile created by `deno check` on Edge Functions (not used by deploys)
deno.lock

# Graphify generated artifacts (regenerate with `npm run graph`)
graph/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# CodeGraph local index (regenerate with `codegraph init`)
.codegraph/

# Local generated artifacts — never commit
email-previews/
supabase/.branches/
e2e-artifacts/
*.bundle

# Database dumps / backups (may contain personal data) — never commit
/*.sql
*.dump
*.sql.gz
backups/

# Credentials and keys
*.pem
*.key
*.p12
id_rsa*
id_ed25519*
*service-account*.json
credentials*.json
.vercel/
